---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
---

<Layout>
  <div class="py-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl md:text-6xl">
        Valles y Rezola
      </h1>
      <p class="mt-6 text-xl text-slate-600 dark:text-slate-400 max-w-3xl mx-auto">
        Especialistas en estructuras de hormigón armado desde 2009.
      </p>
    </section>

    <!-- Historia / experiencia -->
    <Content
      tagline="Nuestra historia"
      title="15 años ejecutando estructuras en Madrid"
      items={[
        {
          title: 'Fundada en 2009',
          description: 'Empezamos ejecutando pequeñas estructuras residenciales.',
        },
        {
          title: 'Especialización',
          description: 'Nos centramos en hormigón armado para obra civil.',
        },
        {
          title: 'Crecimiento',
          description: 'Hoy somos referencia para constructoras y arquitectos.',
        },
      ]}
    />

    <!-- Equipo / valores -->
    <Features
      tagline="Nuestro equipo"
      title="Profesionales con experiencia en obra"
      items={[
        {
          title: 'Capataces especializados',
          description: 'Dirección técnica en todas las obras.',
          icon: 'tabler:users',
        },
        {
          title: 'Oficiales formados',
          description: 'Equipo estable con años de experiencia.',
          icon: 'tabler:tool',
        },
      ]}
    />
  </div>
</Layout>
