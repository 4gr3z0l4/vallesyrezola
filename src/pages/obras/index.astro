---
import Layout from '~/layouts/PageLayout.astro';
import { obras } from '~/data/obras';
---

<Layout>
  <div class="py-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl md:text-6xl">
        Nuestras obras
      </h1>
      <p class="mt-6 text-xl text-slate-600 dark:text-slate-400 max-w-3xl mx-auto">
        +350 proyectos de estructuras de hormigón ejecutados con éxito.
      </p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {obras.map((obra, index) => (
          <article class="group">
            <a href={`/obras/${obra.slug}`}>
              <div class="aspect-video overflow-hidden rounded-xl bg-slate-100">
                <img
                  src={obra.imagen.src}
                  alt={obra.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading={index < 6 ? 'eager' : 'lazy'}
                />
              </div>
              <h3 class="mt-4 font-bold text-xl">{obra.titulo}</h3>
              <p class="text-slate-600 mt-1">{obra.descripcion}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
