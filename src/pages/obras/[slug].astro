---
import Layout from '~/layouts/PageLayout.astro';
import type { GetStaticPaths } from 'astro';
import type { ImageMetadata } from 'astro';
import { obras, type Obra } from '~/data/obras';

// Importamos TODAS las imágenes de obras de forma estática
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/obras/**/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

// DEBUG: mostrar qué carpetas/imágenes encuentra
// console.log('Carpetas encontradas:', Object.keys(allImages));

// Generamos una página por obra
export const getStaticPaths: GetStaticPaths = () => {
  return obras.map((obra) => ({
    params: { slug: obra.slug },
    props: { obra },
  }));
};

const { obra } = Astro.props as { obra: Obra };

if (!obra) {
  throw new Error('Obra no encontrada');
}

// Construimos el array de ImageMetadata a partir de obra.fotos
const galeria: ImageMetadata[] =
  obra.fotos
    ?.map((ruta) => {
      const fullPath = `/src/assets/images/obras/${ruta}`;
      const mod = allImages[fullPath];

      if (!mod) {
        console.warn(`No se encontró la imagen de galería: ${fullPath}`);
        return null; // usamos null en lugar de undefined
      }

      return (mod as { default: ImageMetadata }).default;
    })
    ?.filter((img): img is ImageMetadata => img !== null) ?? []; // non-null assertion
---

<Layout>
  <main class="py-16 sm:py-20 lg:py-24">
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/obras"
        class="inline-flex items-center text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors"
      >
        ← Volver a obras
      </a>

      <header class="mt-6">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-white">
          {obra.titulo}
        </h1>

        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
          {obra.descripcion}
        </p>

        {
          (obra.anio || obra.cliente || obra.localizacion) && (
            <dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm text-slate-600 dark:text-slate-300">
              {obra.anio && (
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 px-4 py-3">
                  <dt class="font-medium text-slate-500 dark:text-slate-400">Año</dt>
                  <dd class="mt-1 text-base">{obra.anio}</dd>
                </div>
              )}

              {obra.cliente && (
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 px-4 py-3">
                  <dt class="font-medium text-slate-500 dark:text-slate-400">Cliente</dt>
                  <dd class="mt-1 text-base">{obra.cliente}</dd>
                </div>
              )}

              {obra.localizacion && (
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 px-4 py-3">
                  <dt class="font-medium text-slate-500 dark:text-slate-400">Localización</dt>
                  <dd class="mt-1 text-base">{obra.localizacion}</dd>
                </div>
              )}
            </dl>
          )
        }
      </header>

      {
        obra.contenido && (
          <article class="mt-10 prose prose-slate max-w-none dark:prose-invert">
            <p>{obra.contenido}</p>
          </article>
        )
      }

      {/* Galería: si no hay fotos definidas, usamos la principal */}
      <section class="mt-10">
        <div class="grid gap-6 md:grid-cols-2">
          {
            (galeria.length ? galeria : [obra.imagen]).map((foto) => (
              <figure class="overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-900/40">
                <img src={foto.src} alt={obra.titulo} class="w-full h-full object-cover" loading="lazy" />
              </figure>
            ))
          }
        </div>
      </section>
    </section>
  </main>
</Layout>
