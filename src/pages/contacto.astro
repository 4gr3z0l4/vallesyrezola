---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <div class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl md:text-6xl mb-12">
      Contacto y presupuestos
    </h1>

    <!-- Datos contacto -->
    <div class="grid md:grid-cols-2 gap-12 mb-16">
      <div>
        <h2 class="text-2xl font-bold mb-6">Datos de contacto</h2>
        <div class="space-y-4 text-lg">
          <p><strong>Teléfono:</strong> <a href="tel:+34666xxxxxx">666 xxx xxx</a></p>
          <p><strong>Email:</strong> <a href="mailto:info@vallesrezola.com">info@vallesrezola.com</a></p>
          <p><strong>Dirección:</strong> Calle Ejemplo 123, 28000 Madrid</p>
        </div>
      </div>

      <!-- Horarios -->
      <div>
        <h2 class="text-2xl font-bold mb-6">Horario</h2>
        <div class="space-y-2">
          <p>Lunes a Viernes: 8:00 - 18:00</p>
          <p>Sábados: 8:00 - 14:00</p>
        </div>
      </div>
    </div>

    <!-- Formulario (usa el que ya trae AstroWind o Netlify Forms) -->
    <section>
      <h2 class="text-2xl font-bold mb-8">Formulario de contacto</h2>
      <!-- Aquí el formulario que ya tienes configurado -->
      <form class="space-y-6 max-w-lg">
        <div>
          <label class="block text-sm font-medium mb-2">Nombre</label>
          <input type="text" class="w-full px-4 py-3 border border-slate-200 rounded-lg" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Email</label>
          <input type="email" class="w-full px-4 py-3 border border-slate-200 rounded-lg" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Teléfono</label>
          <input type="tel" class="w-full px-4 py-3 border border-slate-200 rounded-lg" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Mensaje</label>
          <textarea rows="5" class="w-full px-4 py-3 border border-slate-200 rounded-lg"></textarea>
        </div>
        <button type="submit" class="w-full bg-accent text-white py-4 px-8 rounded-lg font-semibold text-lg">
          Enviar mensaje
        </button>
      </form>
    </section>
  </div>
</Layout>
