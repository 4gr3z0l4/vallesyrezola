---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <div class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl md:text-6xl mb-12">
      Contacto y consultoría técnica
    </h1>

    <!-- Datos contacto -->
    <div class="grid md:grid-cols-2 gap-12 mb-16">
      <div>
        <h2 class="text-2xl font-bold mb-6">Datos de contacto</h2>
        <div class="space-y-4 text-lg">
          <p>
            <strong>Email:</strong>
            <a href="mailto:elu@vallesyrezola.es,miguelangel@vallesyrezola.es"
              ><br /> elu@vallesyrezola.es <br /> miguelangel@vallesyrezola.es</a>
          </p>
        </div>
      </div>

      <!-- Horarios -->
      <div>
        <h2 class="text-2xl font-bold mb-6">Horario</h2>
        <div class="space-y-2">
          <p>Lunes a Viernes: 8:00 - 18:00</p>
          <p>Sábados: 8:00 - 14:00</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
